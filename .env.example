# Copy this file to .env and add the private API key from your email provider.
RESEND_API_KEY=re_your_private_key
# Use a sender address on a domain verified with Resend.
MAIL_FROM=Modern Assets <website@your-verified-domain.com>
MAIL_TO=humzazahid455@gmail.com
API_PORT=3001
# Set this to the exact public website origin when the frontend and API use different domains.
ALLOWED_ORIGINS=http://localhost:8443,https://localhost:8443,http://127.0.0.1:8443,https://127.0.0.1:8443
# For a separately hosted frontend, set this in the frontend build environment:
# VITE_API_URL=https://your-api-host.example
